{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ 编译全部",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-std=c++17",
                "-Wall",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/Polynominal.cpp",
                "${workspaceFolder}/LinearSystem.cpp",
                "-o",
                "${workspaceFolder}/poly"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Mac clang++ 编译全部源文件生成 poly"
        }
    ]
}