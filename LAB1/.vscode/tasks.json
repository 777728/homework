{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: clang 生成活动文件",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/Polynomial.c",
                "${workspaceFolder}/LinearSolver.c",
                "${workspaceFolder}/ui.c",
                "-o",
                "${workspaceFolder}/app",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "用 C11 标准编译整个项目（clang，非 C++）。"
        }
    ],
    "version": "2.0.0"
}
